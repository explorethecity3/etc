# Web3Forms API Key for Contact Form
# Get your free API key from https://web3forms.com
NEXT_PUBLIC_WEB3FORMS_KEY=your_web3forms_access_key_here

# Optional AI wording enhancement through an OpenAI-compatible OmniRoute server.
# The trip planner works from verified local city data when these are omitted.
OMNIROUTE_URL=https://your-private-omniroute.example/v1
OMNIROUTE_API_KEY=replace-with-a-scoped-server-key
OMNIROUTE_MODEL=auto
